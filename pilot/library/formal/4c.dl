% formalizes: claim:lib-4c
% fidelity: yes — "at most six" without counting: no seven distinct open loans of one member.
open_loan_of(M, L) :- loan_member(L, M), open(L).
bottom :- open_loan_of(M, L1), open_loan_of(M, L2), open_loan_of(M, L3), open_loan_of(M, L4),
          open_loan_of(M, L5), open_loan_of(M, L6), open_loan_of(M, L7),
          L1 != L2, L1 != L3, L1 != L4, L1 != L5, L1 != L6, L1 != L7,
          L2 != L3, L2 != L4, L2 != L5, L2 != L6, L2 != L7,
          L3 != L4, L3 != L5, L3 != L6, L3 != L7,
          L4 != L5, L4 != L6, L4 != L7,
          L5 != L6, L5 != L7,
          L6 != L7.
