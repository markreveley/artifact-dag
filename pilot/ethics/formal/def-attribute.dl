% formalizes: def:attribute
% definition: Attribute
% says: By attribute, I mean that which the intellect perceives as constituting the essence of substance.
% attribute(A, S): the intellect perceives A as constituting the essence of
% the substance S.
constitutes_essence(A, S) :- attribute(A, S).
attribute(A, S) :- constitutes_essence(A, S), substance(S).
% Vocabulary that Props. II, IV and V use. Two substances have an identical
% attribute when one attribute belongs to both; "attributes are different"
% is read as sharing none.
same_attribute(X, Y) :- attribute(A, X), attribute(A, Y), X != Y.
different_attributes(X, Y) :- substance(X), substance(Y), X != Y, not same_attribute(X, Y).
distinguished_by_attribute(X, Y) :- attribute(A, X), substance(Y), not attribute(A, Y), X != Y.
distinguished_by_attribute(X, Y) :- attribute(A, Y), substance(X), not attribute(A, X), X != Y.
